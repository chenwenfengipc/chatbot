{
  "name": "chatbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone, channel-agnostic AI chatbot. Website widget first; WhatsApp, Telegram, etc. plug in as channel adapters.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --include \"data/**/*\" src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "transcripts": "tsx src/transcripts-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
