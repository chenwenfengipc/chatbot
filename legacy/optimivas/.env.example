# AI chatbot settings. Copy this file to .env.local (never commit real keys).
# On your host (Vercel, Cloudflare, ...) set the same names in the project's
# environment-variable settings. Restart / redeploy after changing them.
#
# The chatbot picks its AI provider from these variables - switching provider
# is a settings change, no code change.

# --- Option A: Anthropic (Claude) - default ---------------------------------
CHAT_PROVIDER=anthropic
CHAT_MODEL=claude-haiku-5-5
CHAT_API_KEY=
# (ANTHROPIC_API_KEY also works instead of CHAT_API_KEY)

# --- Option B: any OpenAI-compatible provider --------------------------------
# CHAT_PROVIDER=openai-compatible
# CHAT_BASE_URL=<provider's base URL, ending in /v1>
# CHAT_MODEL=<model name at that provider>
# CHAT_API_KEY=<key from that provider>
#
# Examples (check each provider's docs for current base URL and model names):
#   OpenAI      CHAT_BASE_URL=https://api.openai.com/v1
#   Google      CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq        CHAT_BASE_URL=https://api.groq.com/openai/v1        (hosts GPT-OSS 20B)
#   OpenRouter  CHAT_BASE_URL=https://openrouter.ai/api/v1          (many models, incl. GPT-OSS 20B)
#   Together    CHAT_BASE_URL=https://api.together.xyz/v1
#   Ollama      CHAT_BASE_URL=http://localhost:11434/v1             (local, no key needed)

# --- Abuse limits (optional) -------------------------------------------------
# Messages allowed per visitor (per IP) per 10 minutes, and in total per day.
# CHAT_RATE_LIMIT=15
# CHAT_DAILY_LIMIT=2000
