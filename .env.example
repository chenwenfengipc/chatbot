# Copy this file to .env (never commit real keys). On a host, set the same
# names in its environment-variable settings. Restart after changing them.
#
# The AI provider is picked from these variables - switching provider is a
# settings change, no code change.

# --- Option A: Anthropic (Claude) - default ---------------------------------
CHAT_PROVIDER=anthropic
CHAT_MODEL=claude-haiku-5-5
CHAT_API_KEY=
# (ANTHROPIC_API_KEY also works instead of CHAT_API_KEY)

# --- Option B: any OpenAI-compatible provider --------------------------------
# CHAT_PROVIDER=openai-compatible
# CHAT_BASE_URL=<provider's base URL, ending in /v1>
# CHAT_MODEL=<model name at that provider>
# CHAT_API_KEY=<key from that provider>
#
# Examples (check each provider's docs for current base URL and model names):
#   OpenAI      CHAT_BASE_URL=https://api.openai.com/v1
#   Google      CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq        CHAT_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter  CHAT_BASE_URL=https://openrouter.ai/api/v1
#   Together    CHAT_BASE_URL=https://api.together.xyz/v1
#   Ollama      CHAT_BASE_URL=http://localhost:11434/v1             (local, no key needed)

# --- Server ------------------------------------------------------------------
# PORT=8787
# BOTS_DIR=data/bots
# Only behind a reverse proxy you control (so client IPs come from X-Forwarded-For):
# TRUST_PROXY=true

# --- Abuse limits (optional) -------------------------------------------------
# Messages allowed per user per 10 minutes, and per bot per day.
# CHAT_RATE_LIMIT=15
# CHAT_DAILY_LIMIT=2000

# --- Transcripts -------------------------------------------------------------
# Every conversation (visitor's name/email/phone/description + all messages) is
# saved here, one file each. Contains personal data: keep it private and back it up.
# TRANSCRIPTS_DIR=data/transcripts
